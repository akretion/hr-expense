<odoo>
    <record id="view_hr_expense_tax_line_tree" model="ir.ui.view">
        <field name="name">hr.expense.tax.line.tree</field>
        <field name="model">hr.expense.tax.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="company_id" invisible="1" />
                <field name="sequence" widget="handle" />
                <field name="tax_ids" widget="many2many_tags" />
                <field
                    name="base_amount_currency"
                    widget="monetary"
                    options="{'currency_field': 'currency_id'}"
                />
                <field
                    name="tax_amount_currency"
                    widget="monetary"
                    options="{'currency_field': 'currency_id'}"
                />
                <field
                    name="total_amount_currency"
                    widget="monetary"
                    options="{'currency_field': 'currency_id'}"
                />
            </tree>
        </field>
    </record>

    <record id="hr_expense_view_form_tax_distribution" model="ir.ui.view">
        <field name="name">hr.expense.form.tax.distribution</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form" />
        <field name="arch" type="xml">
            <!-- Display fields for taxes for all users -->
            <xpath expr="//field[@name='tax_ids']" position="attributes">
                <attribute name="groups" />
            </xpath>

            <!-- Add has_tax_distribution as invisible field for domain use -->
            <xpath expr="//field[@name='tax_ids']" position="before">
                <field name="has_tax_distribution" invisible="1" />
            </xpath>

            <!-- After the existing tax_ids row, insert the distribution lines. -->
            <xpath expr="//field[@name='tax_ids']/.." position="after">
                <div
                    attrs="{'invisible': [('has_tax_distribution', '=', False)]}"
                    class="o_expense_tax_distribution"
                >
                    <div class="o_form_label font-weight-bold">Tax Distribution</div>
                    <div class="text-muted font-italic mb-1" style="font-size:0.85em;">
                        Distribute the expense total across the applicable tax rates.
                        The sum of the "Total (Tax Incl.)" column must equal the
                        expense total.
                    </div>
                    <field
                        name="tax_line_ids"
                        widget="one2many"
                        attrs="{'readonly': [('is_editable', '=', False)]}"
                        context="{'default_expense_id': id}"
                    >
                        <tree editable="bottom">
                            <field name="company_id" invisible="1" />
                            <field name="sequence" widget="handle" />
                            <field name="tax_ids" widget="many2many_tags" />
                            <field
                                name="base_amount_currency"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                            />
                            <field
                                name="tax_amount_currency"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                            />
                            <field
                                name="total_amount_currency"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                            />
                        </tree>
                    </field>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
